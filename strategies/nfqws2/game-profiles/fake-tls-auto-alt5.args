# Game Filter из general (FAKE TLS AUTO ALT5).bat -> NFQWS2
# Не самостоятельный конфиг. Вставлять ПОСЛЕ основных профилей в
# NFQWS_ARGS_CUSTOM и расширять TCP_PORTS / UDP_PORTS, иначе диапазон
# 1024-65535 перехватит чужой трафик.

--filter-tcp=1024-65535
--ipset=/etc/nfqws2/lists/ipset.list
--ipset-exclude=/etc/nfqws2/lists/ipset_exclude.list
--ipset-exclude=/etc/nfqws2/lists/ipset_exclude-extra.list
--out-range=-n4
--payload=tls_client_hello,unknown
--lua-desync=fake:blob=tls_clienthello_teamspeak_com_full:repeats=11:tcp_ts=-600000:payload=tls_client_hello,unknown
--lua-desync=multidisorder:pos=2,midsld:payload=tls_client_hello,unknown
--payload=http_req
--lua-desync=fake:blob=tls_clienthello_teamspeak_com_full:repeats=11:tcp_ts=-600000
--lua-desync=multidisorder:pos=2,midsld
--new
--filter-udp=1024-65535
--ipset=/etc/nfqws2/lists/ipset.list
--ipset-exclude=/etc/nfqws2/lists/ipset_exclude.list
--ipset-exclude=/etc/nfqws2/lists/ipset_exclude-extra.list
--out-range=-n3
--payload=all
--lua-desync=fake:blob=quic_initial_4pda_to:repeats=10:payload=all
