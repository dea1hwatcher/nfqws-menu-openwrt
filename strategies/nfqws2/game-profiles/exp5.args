# Game Filter из general (EXP5).bat -> NFQWS2
# Не самостоятельный конфиг. Вставлять ПОСЛЕ основных профилей в
# NFQWS_ARGS_CUSTOM и расширять TCP_PORTS / UDP_PORTS, иначе диапазон
# 1024-65535 перехватит чужой трафик.

--filter-tcp=1024-65535
--ipset=/etc/nfqws2/lists/ipset.list
--ipset-exclude=/etc/nfqws2/lists/ipset_exclude.list
--ipset-exclude=/etc/nfqws2/lists/ipset_exclude-extra.list
--out-range=-n5
--payload=tls_client_hello
--lua-desync=tls_client_hello_clone:blob=ch_clone:fallback=tls_sferum:sni_del:sni_first=4pda.to:sni_snt_new=0
--lua-desync=fake:blob=ch_clone:repeats=6:tcp_ts=-600000
--lua-desync=multisplit:pos=sniext+1,midsld:seqovl=1
--payload=http_req,unknown
--lua-desync=fake:blob=tls_clienthello_max_ru:repeats=6:tcp_ts=-600000:payload=http_req,unknown
--lua-desync=multisplit:pos=2:seqovl=664:seqovl_pattern=tls_clienthello_max_ru:payload=http_req,unknown
--new
--filter-udp=1024-65535
--ipset=/etc/nfqws2/lists/ipset.list
--ipset-exclude=/etc/nfqws2/lists/ipset_exclude.list
--ipset-exclude=/etc/nfqws2/lists/ipset_exclude-extra.list
--out-range=-n4
--payload=all
--lua-desync=fake:blob=quic_initial_4pda_to:repeats=10:payload=all
