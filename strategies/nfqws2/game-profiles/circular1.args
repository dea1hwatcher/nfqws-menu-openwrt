# Game Filter из general (CIRCULAR1).bat -> NFQWS2
# Не самостоятельный конфиг. Вставлять ПОСЛЕ основных профилей в
# NFQWS_ARGS_CUSTOM и расширять TCP_PORTS / UDP_PORTS, иначе диапазон
# 1024-65535 перехватит чужой трафик.

--filter-tcp=1024-65535
--ipset=/etc/nfqws2/lists/ipset.list
--ipset-exclude=/etc/nfqws2/lists/ipset_exclude.list
--ipset-exclude=/etc/nfqws2/lists/ipset_exclude-extra.list
--out-range=-n4
--payload=tls_client_hello,unknown
--lua-desync=fake:blob=tls_clienthello_4pda_to:repeats=6:tcp_ts=-600000:payload=tls_client_hello,unknown
--lua-desync=multisplit:pos=2:seqovl=284:seqovl_pattern=tls_clienthello_4pda_to:payload=tls_client_hello,unknown
--new
--filter-udp=1024-65535
--ipset=/etc/nfqws2/lists/ipset.list
--ipset-exclude=/etc/nfqws2/lists/ipset_exclude.list
--ipset-exclude=/etc/nfqws2/lists/ipset_exclude-extra.list
--out-range=-n3
--payload=known,unknown
--lua-desync=fake:blob=quic_initial_4pda_to:repeats=8:payload=known,unknown
