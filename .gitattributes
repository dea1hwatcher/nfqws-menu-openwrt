# Скрипты и конфиги всегда с LF: на busybox ash (OpenWrt/Entware) CRLF ломает
# парсер (`then\r`, `: not found` при source конфига) и меняет SHA256 файлов.
* text=auto
*.sh text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.list text eol=lf
strategies/dns_filter_* text eol=lf
hosts text eol=lf
domains_geohide text eol=lf
SHA256SUMS text eol=lf
LICENSE text eol=lf

# Двоичные blob'ы и пакеты — без каких-либо преобразований
*.bin binary
*.ipk binary
*.gz binary
*.tar binary
*.xz binary
